# Supabase project settings — Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix with NEXT_PUBLIC_ or import from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the cron endpoint checks for (Authorization: Bearer <value>).
# Generate one with: openssl rand -hex 32
CRON_SECRET=change-me-to-a-long-random-value

# Base URL of this deployment, used to build links inside notifications/emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Maximum number of competitors that can be configured (see Settings > Competitors).
MAX_COMPETITORS=10

# Temporary: skip login and use service-role for data access.
# Must be explicitly "true" — omit or set false on production when using real auth.
DISABLE_AUTH=true
